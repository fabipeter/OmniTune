# Copy to .env (never commit). All optional for local dev.
PORT=8787
# REQUIRED in production: a long random string (openssl rand -base64 48)
JWT_SECRET=change-me
# Comma-separated list of web origins allowed to call the API (omit in dev to allow all)
CORS_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/omnitune.db

# Optional — enables full-length playback through MusicKit (needs a developer program membership):
# APPLE_TEAM_ID=ABCDE12345
# APPLE_KEY_ID=KEYID12345
# APPLE_PRIVATE_KEY_PATH=./AuthKey_KEYID12345.p8   # or APPLE_PRIVATE_KEY with the .p8 contents (\n escaped)
