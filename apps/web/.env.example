# Optional: URL of the OmniTune sync & MusicKit token server (apps/server)
# Leave unset or pointing to localhost:8787 for local dev — guest mode works with no server running.
VITE_API_URL=http://localhost:8787

# Set to 1 to proxy iTunes/RSS catalog calls through VITE_API_URL (reduces client rate-limits)
VITE_USE_SERVER_CATALOG=0

# Optional: static MusicKit developer JWT (normally fetched from VITE_API_URL/apple/developer-token)
# VITE_APPLE_DEV_TOKEN=
